# API Keys (uncomment and set as needed)
# OPENAI_API_KEY=your-openai-api-key-here
# MISTRAL_API_KEY=your-mistral-api-key-here
# GEMINI_API_KEY=your-google-ai-studio-api-key-here
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Override the default DashScope endpoint if your account uses the
# China/Beijing region instead of the international endpoint.
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: Override data directory path
# LEGISCOPE_DATA_DIR=/custom/path/to/data
